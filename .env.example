# Copy to .env and fill in. Never commit .env.

# Which provider the server uses for live generation: "gemini" or "anthropic".
LLM_PROVIDER=gemini

# Model id for the selected provider. Pinned rather than an alias such as
# gemini-flash-latest, so a published eval result keeps meaning the same thing.
LLM_MODEL=gemini-3.6-flash

# Provider credentials. Only the key for the selected provider is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Client-side throttle applied to every outbound provider call.
LLM_REQUESTS_PER_MINUTE=4
LLM_MAX_RETRIES=6

# Agent loop bounds.
AGENT_MAX_ITERATIONS=12
AGENT_TIME_BUDGET_MS=120000

# Server.
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# "replay" serves precomputed traces and makes live provider calls impossible.
# "live" allows generation for callers presenting DEMO_ACCESS_TOKEN.
DEMO_MODE=replay
DEMO_ACCESS_TOKEN=

# Public API guard rails.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_PROMPT_CHARS=2000
