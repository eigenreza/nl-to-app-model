# Copy to .env and fill in. Never commit .env.

# Which provider the server uses for live generation: "gemini" or "anthropic".
LLM_PROVIDER=gemini

# Model id for the selected provider. Pinned rather than an alias such as
# gemini-flash-latest, so a published eval result keeps meaning the same thing.
LLM_MODEL=gemini-3.6-flash

# Provider credentials. Only the key for the selected provider is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Client-side throttle applied to every outbound provider call.
LLM_REQUESTS_PER_MINUTE=4
LLM_MAX_RETRIES=6

# Hard ceiling on what one process may spend, in USD, enforced from the token
# counts the provider reports rather than merely estimated beforehand.
# Zero means no ceiling, which is right for a free tier.
LLM_SPEND_CAP_USD=3

# Cache the static system and tool prefix between calls, where supported.
LLM_PROMPT_CACHING=true

# Agent loop bounds.
AGENT_MAX_ITERATIONS=12
AGENT_TIME_BUDGET_MS=120000

# Server.
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# "replay" serves precomputed traces and makes live provider calls impossible.
# "live" allows generation for callers presenting DEMO_ACCESS_TOKEN.
DEMO_MODE=replay
DEMO_ACCESS_TOKEN=

# Live generation guards. A recorded prompt is always served from replay and
# never spends any of this, so the sample prompts keep working once it is gone.
#
# Ceiling on live spend for one UTC day, computed from the token counts the
# provider reports and held on disk so a restart does not reset it. Reaching it
# turns live generation off until the day turns.
DAILY_SPEND_CAP_USD=0.30
# Held back so a generation only starts with room to finish.
LIVE_RESERVE_USD=0.05
# Live generations one address may start per UTC day.
LIVE_PER_IP_PER_DAY=3
# Live generations in flight at once, across everyone.
LIVE_MAX_CONCURRENT=1
# Where the ledger is written. On a deployment this must be storage that
# survives a restart, or the budget resets whenever the process does.
# Defaults to .local/budget-state.json inside the repository.
BUDGET_STATE_PATH=

# Public API guard rails.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
MAX_PROMPT_CHARS=2000
